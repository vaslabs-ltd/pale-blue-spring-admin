package build


import mill.*, kotlinlib.* , publish.*
import javalib.spring.boot.SpringBootModule


trait BaseSpringBootModule extends SpringBootModule, KotlinModule { outer =>

  override def springBootPlatformVersion = "3.5.3"

  override def kotlinVersion = "2.2.20"

  override def kotlincOptions: T[Seq[String]] = super.kotlincOptions() ++ Seq(
    "-jvm-target",
    "21",
    "-Xjsr305=strict",
  )

  // AOT ??
}

object lib extends BaseSpringBootModule, PublishModule {
  override def artifactName: T[String] = "springadmin"

  override def mvnDeps = Seq(
    mvn"org.springframework.boot:spring-boot-starter-web",
    mvn"com.fasterxml.jackson.module:jackson-module-kotlin",
    mvn"org.jetbrains.kotlin:kotlin-reflect",
    mvn"org.springframework.boot:spring-boot-starter-thymeleaf",

    mvn"org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
    mvn"org.jetbrains.kotlinx:kotlinx-coroutines-reactor:1.10.2",
  )

  override def compileMvnDeps = super.compileMvnDeps() ++ Seq(
    mvn"org.springframework.boot:spring-boot-starter-data-jpa"
  )

  def publishVersion = "1.1.0"

  def pomSettings = PomSettings(
    description = "A Spring Boot Admin UI module for viewing data stored in a database",
    organization = "com.paleblueapps",
    url = "https://github.com/paleblueapps/pale-blue-spring-admin",
    licenses = Seq(
      License.`Apache-2.0`
    ),
    developers = Seq(
      Developer(
        id = "paleblueapps",
        name = "Pale Blue"
      )
    ),
    versionControl = VersionControl.github("paleblueapps", "pale-blue-spring-admin")
  )

}