package build.example

import mill.*
import mill.kotlinlib.*
import mill.javalib.spring.boot.SpringBootModule
import build.BaseSpringBootModule
import build.lib

object `package` extends BaseSpringBootModule { outer =>

  lib.publishLocal()

  override def mvnDeps = Seq(
    mvn"org.springframework.boot:spring-boot-starter",
    mvn"org.jetbrains.kotlin:kotlin-reflect",
    mvn"org.springframework.boot:spring-boot-starter-data-jpa",
    mvn"org.hibernate.orm:hibernate-community-dialects",
    mvn"com.paleblueapps:springadmin:${lib.publishVersion()}",
  )

  override def runMvnDeps: T[Seq[Dep]] = super.runMvnDeps() ++ Seq(
    mvn"org.xerial:sqlite-jdbc"
  )

}