package build.example

import mill.*
import mill.kotlinlib.*
import mill.javalib.spring.boot.SpringBootModule
import build.BaseSpringBootModule
import build.lib

import scala.util.control.NonFatal

object `package` extends BaseSpringBootModule { outer =>

  override def kotlincPluginMvnDeps =
    super.kotlincPluginMvnDeps() ++ Seq(
      mvn"org.jetbrains.kotlin:kotlin-noarg-compiler-plugin:${kotlinVersion()}"
    )

  override def kotlincOptions: T[Seq[String]] =
    super.kotlincOptions()
    ++ allOpenAnnotations.flatMap(opt => Seq("-P", s"plugin:org.jetbrains.kotlin.noarg:annotation:${opt}"))


  override def mvnDeps = Seq(
    mvn"org.springframework.boot:spring-boot-starter",
    mvn"org.jetbrains.kotlin:kotlin-reflect",
    mvn"org.springframework.boot:spring-boot-starter-data-jpa",
    mvn"org.hibernate.orm:hibernate-community-dialects",
  )

  override def runMvnDeps = super.runMvnDeps() ++ Seq(
    mvn"org.xerial:sqlite-jdbc"
  )

  override def moduleDeps = Seq(
    lib
  )

  // Use moduleDir for the run tasks
  override def forkWorkingDir = moduleDir

}